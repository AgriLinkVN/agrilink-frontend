# AgriLink Frontend environment template
# Copy to .env.local for local development, or configure these keys in Vercel/hosting.

# Public site URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# P4 frontend data source: "mock" for the judging demo, "api" after backend integration.
NEXT_PUBLIC_P4_DATA_MODE=mock

# Map/GIS
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# Cloudinary unsigned client uploads used by forum/editor fallback flows
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional observability
NEXT_PUBLIC_SENTRY_DSN=
