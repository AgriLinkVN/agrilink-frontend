# AgriLink Frontend environment template
# Copy to .env.local for local development, or configure these keys in Vercel/hosting.

# Backend-free demo deployment
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Real backend mode only. Set NEXT_PUBLIC_DEMO_MODE=false and provide one URL.
# NEXT_PUBLIC_API_URL is canonical; NEXT_PUBLIC_BACKEND_URL remains supported
# for existing deployments during migration.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_URL=

# P4 frontend data source: "mock" for the judging demo, "api" after backend integration.
NEXT_PUBLIC_P4_DATA_MODE=mock

# Map/GIS (optional in Demo Mode)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary unsigned client uploads used by forum/editor fallback flows
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional observability
NEXT_PUBLIC_SENTRY_DSN=
